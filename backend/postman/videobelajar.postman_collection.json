{
    "info": {
        "name": "videobelajar API - Pengujian Endpoint /course",
        "description": "Koleksi pengujian untuk REST API videobelajar (Langkah 4: Testing). Jalankan server dengan `npm start` dari folder backend, lalu jalankan koleksi ini lewat Collection Runner. Urutan request penting karena POST menyimpan id kelas baru ke variabel {{createdId}} yang dipakai request berikutnya.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000"
        },
        {
            "key": "createdId",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "1. GET (SELECT)",
            "item": [
                {
                    "name": "GET semua kelas",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                                    "pm.test(\"total sama dengan jumlah data\", () => { const r = pm.response.json(); pm.expect(r.data).to.be.an(\"array\"); pm.expect(r.total).to.eql(r.data.length); });",
                                    "pm.test(\"ada minimal 1 kelas dengan kategori dan tutor\", () => { const c = pm.response.json().data[0]; pm.expect(c).to.have.property(\"category\"); pm.expect(c.tutors).to.be.an(\"array\"); });"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/course",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "course"
                            ]
                        },
                        "description": "Mengambil semua kelas beserta kategori dan tutornya."
                    }
                },
                {
                    "name": "GET kelas berdasarkan id",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                                    "pm.test(\"id kelas = 1\", () => pm.expect(pm.response.json().data.id).to.eql(1));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/course/1",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "course",
                                "1"
                            ]
                        },
                        "description": "Mengambil satu kelas berdasarkan id."
                    }
                },
                {
                    "name": "GET filter kategori",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                                    "pm.test(\"semua kelas berkategori 1\", () => pm.response.json().data.forEach((c) => pm.expect(c.course_category_id).to.eql(1)));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/course?category_id=1",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "course"
                            ],
                            "query": [
                                {
                                    "key": "category_id",
                                    "value": "1"
                                }
                            ]
                        },
                        "description": "Filter kelas berdasarkan kategori (atribut lain)."
                    }
                },
                {
                    "name": "GET cari judul",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                                    "pm.test(\"judul memuat kata kunci\", () => { const data = pm.response.json().data; pm.expect(data.length).to.be.above(0); data.forEach((c) => pm.expect(c.title.toLowerCase()).to.include(\"marketing\")); });"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/course?keyword=Marketing",
                            "host": [
                                "{{baseUrl}}"
